FROM jupyter/base-notebook:latest

USER root

RUN apt-get update --yes \
    && apt-get install --yes --no-install-recommends openjdk-17-jdk-headless \
    && ln -s "$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")" /opt/java \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/opt/java
ENV PATH="${JAVA_HOME}/bin:${PATH}"

RUN python -m pip install --no-cache-dir pyspark==4.1.3

# Preserve the notebook image's unprivileged runtime user.
USER ${NB_UID}

# Cấu hình SPARK_MASTER
ENV SPARK_MASTER=spark://spark-master-svc:7077

# Expose port 8888 cho Jupyter
EXPOSE 8888

# Start JupyterLab (default command)
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--NotebookApp.token=", "--NotebookApp.password="]
